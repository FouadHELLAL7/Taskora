# =============================================================================
# Taskora - environment configuration for docker compose
# =============================================================================
#
#   cp .env.example .env
#   chmod 600 .env
#   # set the two REQUIRED secrets below, then:
#   docker compose up -d --build
#
# `bash scripts/install.sh` does all of this for you (it generates the secrets
# and never overwrites values you have already set).
#
# Rules for this file:
#   - KEY=value, no spaces around "=". Quotes are optional.
#   - Docker Compose interpolates "$" in values: write "$$" for a literal "$".
#     Hex secrets from `openssl rand -hex 32` avoid this (and URL-encoding).
#   - Never commit .env (it is in .gitignore) and keep it readable by root /
#     the deploy user only. Back it up somewhere safe: without
#     TASKORA_ENCRYPTION_KEY, stored integration secrets cannot be decrypted.
#   - Optional settings that are commented out use the defaults shown. Leave
#     them commented out rather than setting an empty value.

# -----------------------------------------------------------------------------
# REQUIRED secrets - docker compose refuses to start while these are empty.
# -----------------------------------------------------------------------------

# Password of the PostgreSQL role used by Taskora. Generate with:
#   openssl rand -hex 32
# Only hex/URL-safe characters: it is embedded in the database URL.
# Changing it later does NOT change the password inside an existing database
# volume (see docs/deployment.md, "Troubleshooting").
POSTGRES_PASSWORD=

# 32-byte key (64 hex characters) that encrypts integration secrets (e.g.
# Action1 API credentials) at rest. Generate with:
#   openssl rand -hex 32
# Keep a copy in your password manager. If it is lost or rotated, every stored
# integration secret must be re-entered in the UI.
TASKORA_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Network exposure (web container - the only published port)
# -----------------------------------------------------------------------------

# Host address the web UI is published on.
#   0.0.0.0    reachable from your LAN on every host interface (default).
#              Do NOT port-forward this to the internet; put a TLS reverse
#              proxy in front instead.
#   127.0.0.1  only reachable from this host - use this when a reverse proxy
#              (Caddy, nginx, Traefik) on the same host terminates HTTPS.
#   192.0.2.10 a specific interface/IP of this host.
TASKORA_BIND_ADDRESS=0.0.0.0

# Host port for the web UI (container port is always 8080).
TASKORA_HTTP_PORT=8080

# CIDR of a reverse proxy in front of Taskora whose X-Forwarded-For header is
# trusted to carry the real client IP (used for login rate limiting and audit
# logs). Default trusts nobody, which is right for direct LAN access.
# Behind a reverse proxy on the same host (connecting to 127.0.0.1:PORT) the
# proxy appears as the Docker bridge gateway, typically in 172.16.0.0/12;
# for a proxy on another machine use its IP, e.g. 192.168.1.5/32.
# TASKORA_TRUSTED_PROXY=127.0.0.1/32

# Maximum HTTP request body accepted by the web proxy (attachments). Keep it a
# little above MAX_UPLOAD_MB to allow for multipart overhead.
# NGINX_CLIENT_MAX_BODY_SIZE=30m

# -----------------------------------------------------------------------------
# Cookies / sessions
# -----------------------------------------------------------------------------

# Secure flag on the session cookie:
#   auto   Secure when the request arrived over HTTPS (X-Forwarded-Proto from
#          your reverse proxy is honoured). Works for plain-HTTP LAN access
#          and for HTTPS behind a proxy. (default)
#   true   always Secure - use when Taskora is ONLY reached via HTTPS.
#          Logging in over plain http:// will then not work.
#   false  never Secure - not recommended.
COOKIE_SECURE=auto

# Session lifetime in hours (1 - 2160).
# SESSION_TTL_HOURS=12

# Trust X-Forwarded-* headers from the bundled nginx (which sanitises them).
# Leave true for the docker compose setup.
# TRUST_PROXY=true

# -----------------------------------------------------------------------------
# First-run setup
# -----------------------------------------------------------------------------

# While no administrator exists, the API logs a random one-time setup token:
#   docker compose logs api | grep -i "setup token"
# Alternatively fix the token here (at least 16 characters, e.g.
# `openssl rand -hex 16`) and remove it again once setup is complete.
# TASKORA_SETUP_TOKEN=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Role and database created on first start of the postgres container. Changing
# these after the first start requires migrating the data yourself.
POSTGRES_USER=taskora
POSTGRES_DB=taskora

# Connection pool size per API process (worker uses at most 5).
# DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# Uploads, logging, worker
# -----------------------------------------------------------------------------

# Maximum size of a single uploaded file in MB (1 - 512). Raise
# NGINX_CLIENT_MAX_BODY_SIZE accordingly.
# MAX_UPLOAD_MB=25

# fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info

# How often the worker polls for queued jobs, in milliseconds (min. 200).
# WORKER_POLL_MS=2000

# -----------------------------------------------------------------------------
# Image build (advanced)
# -----------------------------------------------------------------------------

# Tag for the locally built images taskora-api:<tag> / taskora-web:<tag>.
# TASKORA_IMAGE_TAG=local

# Version label baked into the images.
# TASKORA_VERSION=dev

# Used by scripts/backup.sh: number of backups to keep (0 = keep all).
# KEEP=14

# ---------------------------------------------------------------------------
# E-mail notifications (optional). In-app notifications always work; when an
# SMTP relay is configured, the worker also e-mails them (users can opt out
# from their account menu). PUBLIC_URL is used for links in e-mails.
# ---------------------------------------------------------------------------
# PUBLIC_URL=https://psa.example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Taskora <taskora@example.com>"

# ---------------------------------------------------------------------------
# Inbound e-mail to ticket (optional). The worker polls this mailbox every
# minute: messages from known contacts/company domains become tickets, replies
# containing a ticket number (e.g. [TKA-000142]) are added to that ticket.
# Configure the fallback company and queue in System Settings → General.
# ---------------------------------------------------------------------------
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER=support@example.com
# IMAP_PASSWORD=
# IMAP_MAILBOX=INBOX
