# Security headers for the Taskora SPA (included by taskora.conf.template).
#
# nginx only inherits add_header directives from the enclosing level when a
# location defines none of its own, so every location that adds a header
# must include this file again.
#
# __CSP_SCRIPT_HASHES__ is replaced at image build time by
# inject-csp-hashes.mjs with the sha256 hashes of the inline scripts found in
# the built index.html (currently only the pre-paint theme script).
#
# style-src needs 'unsafe-inline': Radix UI / sonner inject <style> elements
# at runtime. Scripts stay strict (no 'unsafe-inline', no 'unsafe-eval').

add_header Content-Security-Policy "default-src 'self'; script-src 'self' __CSP_SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; frame-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
add_header Cross-Origin-Opener-Policy "same-origin" always;
add_header X-Permitted-Cross-Domain-Policies "none" always;
